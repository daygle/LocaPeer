<?xml version="1.0" encoding="utf-8"?>
<!--
    The British and Australian English variants override only the strings whose spelling
    differs from the default (en) locale; every other string falls back to res/values/.
    That intentional partial coverage is the only place MissingTranslation is allowed to
    stay silent - see the lint block in app/build.gradle.kts.

    Matched by regexp rather than by path because lint resolves <ignore path> relative to
    the module directory, which silently matches nothing when it is spelled differently.
-->
<lint>
    <issue id="MissingTranslation">
        <ignore regexp="values-en-rGB|values-en-rAU" />
    </issue>
</lint>
